{
    "$schema": "https://tauri.app/schemas/config-schema.json",
    "productName": "Typst IDE",
    "version": "1.7.4",
    "identifier": "com.typst.ide",
    "build": {

        "frontendDist": "../../frontend/dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Typst IDE",
                "width": 1200,
                "height": 800
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; frame-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
        }
    },
    "plugins": {
        "opener": {
            "requireLiteralLeadingDot": false
        }
    },

    "bundle": {
        "active": true,
        "targets": ["appimage", "deb", "rpm", "nsis"],
        "category": "Productivity",
        "shortDescription": "A modern, local-first Typst editor",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png"
        ],
        "linux": {
            "appimage": {
                "bundleMediaFramework": false
            },
            "deb": {
                "desktopTemplate": "../../typst-ide.desktop"
            },
            "rpm": {
                "desktopTemplate": "../../typst-ide.desktop"
            }
        }
    }
}
