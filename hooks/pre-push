#!/usr/bin/env bash
# pre-push hook: verify that all project version files are consistent, that
# any pushed tag vX.Y.Z matches the version in those files, and that the
# frontend npm audit passes (same check as CI, see .github/workflows/ci.yml)
set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"

CARGOTOML="$REPO_ROOT/crates/app/Cargo.toml"
TAURICONF="$REPO_ROOT/crates/app/tauri.conf.json"
PKGBUILD="$REPO_ROOT/PKGBUILD"
METAINFO="$REPO_ROOT/flatpak/io.github.gnoooo.typst-ide.metainfo.xml"

fail() {
  echo "pre-push: $1" >&2
  exit 1
}

for f in "$CARGOTOML" "$TAURICONF" "$PKGBUILD"; do
  [ -f "$f" ] || fail "file not found: $f"
done

. "$REPO_ROOT/scripts/version.sh"
cargo_ver="$(version_from_toml "$CARGOTOML")"
tauri_ver="$(version_from_json "$TAURICONF")"
pkgbuild_ver="$(version_from_pkgbuild "$PKGBUILD")"
metainfo_ver="$(version_from_metainfo "$METAINFO" 2>/dev/null)"

# Checks A + C in one place: the file list must agree with the Cargo.toml version,
# including the Flatpak metainfo (same rule as manage.sh check_consistency).
mismatches="$(version_mismatches "$cargo_ver" "$tauri_ver" "$pkgbuild_ver" "$metainfo_ver")"
if [ -n "$mismatches" ]; then
  {
    echo "pre-push: version files are inconsistent:"
    echo "$mismatches" | sed 's/^/  /'
    echo "  crates/app/Cargo.toml holds the reference version, align the files above"
  } >&2
  exit 1
fi

# Check D: frontend npm audit, exact same command as CI: any vulnerability
# found here would fail the GitHub workflow after the push. Best effort: skip
# silently (with a note) when npm is missing or the audit cannot run (network).
if ! command -v npm >/dev/null 2>&1; then
  echo "pre-push: npm not installed, skipping frontend audit" >&2
elif audit_out="$( cd "$REPO_ROOT/frontend" && npm audit --package-lock-only 2>&1 )"; then
  echo "pre-push: frontend npm audit: no vulnerabilities."
elif printf '%s\n' "$audit_out" | grep -qE '[0-9]+ [a-z]+ severity vulnerabilit(y|ies)'; then
  {
    echo "pre-push: frontend npm audit found vulnerabilities:"
    printf '%s\n' "$audit_out" | sed 's/^/  /'
    echo "  fix with: cd frontend && npm audit fix (weaker: git push --no-verify, CI will still fail)"
  } >&2
  exit 1
else
  echo "pre-push: npm audit could not run (network?), skipping" >&2
fi

# Check B: every pushed tag refs/tags/vX.Y.Z must match the file version
tags=""
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/tags/v*)
      tag_ver="${remote_ref#refs/tags/v}"
      [ -n "$tags" ] && tags="$tags $tag_ver" || tags="$tag_ver"
      if [ "$tag_ver" != "$cargo_ver" ]; then
        fail "pushed tag v$tag_ver does not match version files ($cargo_ver). Bump the version or fix the tag before pushing."
      fi
      ;;
  esac
done

if [ -n "$tags" ]; then
  echo "pre-push: tags v$tags match version files ($cargo_ver)."
fi

exit 0
